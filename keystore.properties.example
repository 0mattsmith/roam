# Copy to keystore.properties and fill in. NEVER commit the real file.
# Generate the keystore once with:
#
#   keytool -genkeypair -v -keystore roam-release.jks -alias roam \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# Then back up roam-release.jks AND these passwords somewhere safe.
# If you lose them you can never update an installed Roam again.

storeFile=../roam-release.jks
storePassword=CHANGE_ME
keyAlias=roam
keyPassword=CHANGE_ME
